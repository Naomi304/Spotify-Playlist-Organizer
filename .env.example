# Copy this file to .env.local and fill in your own values.
# Your Client ID is on your app's page in the Spotify Developer Dashboard.
REACT_APP_SPOTIFY_CLIENT_ID=your_client_id_here

# Must exactly match a Redirect URI in your Spotify app's settings
REACT_APP_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Serve the dev server on the same address as the redirect URI
HOST=127.0.0.1
